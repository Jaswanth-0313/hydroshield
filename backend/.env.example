# HYDROSHIELD Backend Configuration
# Copy this file to .env for local development
# For production deployment, set these variables on the hosting platform

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=false
PORT=8000

# CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development

# Database / storage (if added later)
# DATABASE_URL=

# External API keys
# MAP_API_KEY=
# AI_API_KEY=
# OTHER_REQUIRED_SECRET=
