# HYDROSHIELD Frontend Configuration
# Copy this file to .env.local for local development
# For production deployment, set these environment variables on your hosting platform

# API Base URL
# For local development: omit this or set to http://localhost:8000/api
# For production: set to your deployed backend URL (e.g., https://api.yourhost.com/api)
VITE_API_BASE_URL=/api

# Application environment
VITE_APP_ENV=development
