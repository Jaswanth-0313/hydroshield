# HYDROSHIELD Backend Configuration
# Copy this file to .env for local development
# For production deployment, set these environment variables on your hosting platform

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true

# CORS Configuration - specify your frontend URL for production
CORS_ORIGINS=*

# Application Environment
APP_ENV=development

# Database (if applicable in future)
# DATABASE_URL=

# API Keys (if using external services)
# MAPBOX_ACCESS_TOKEN=
# DELFT3D_LICENSE_KEY=
